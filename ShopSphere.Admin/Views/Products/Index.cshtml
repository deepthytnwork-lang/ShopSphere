@{
}
@model List<ShopSphere.Application.Products.ProductDto>
@{
    ViewData["Title"] = "Products";
}
<h1>Products</h1>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Price</th><th>Stock</th></tr>
    </thead>
    <tbody>
        @foreach(var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price.ToString("C")</td>
                <td>@p.Stock</td>
            </tr>
        }
    </tbody>
        </table>